{
  "name": "antigravity-computer-browser-use",
  "version": "1.0.0",
  "description": "High-speed, zero-popup macOS Computer Use, Chrome Browser Use, and Apple Safari Browser Use MCP servers for Antigravity and MCP-compatible AI agents",
  "bin": {
    "antigravity-cua-mcp": "bin/antigravity-cua-mcp.js",
    "antigravity-browser-mcp": "bin/antigravity-browser-mcp.js",
    "antigravity-safari-mcp": "bin/antigravity-safari-mcp.js"
  },
  "scripts": {
    "build": "swiftc -O bin/antigravity-cua-native.swift -o bin/antigravity-cua-native",
    "test": "node tests/test_smoke.js",
