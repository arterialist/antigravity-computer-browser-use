{
  "manifest_version": 3,
  "name": "Antigravity Browser Bridge",
  "short_name": "Antigravity Bridge",
  "version": "1.0.0",
  "description": "Native browser automation bridge for Antigravity AI coding assistant",
  "key": "",
  "permissions": [
    "tabs",
    "activeTab",
    "scripting",
    "storage",
    "alarms",
    "nativeMessaging",
    "downloads",
    "debugger"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Antigravity Browser Bridge",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
